digraph modelo_gold {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, label="Capa Gold · Modelo dimensional (esquema estrella)\nRed Metropolitana de Transporte", labelloc=t, nodesep=0.35, ranksep=1.3, bgcolor=white, pad=0.4];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [color="#555555", arrowhead=crow, arrowtail=none, penwidth=1.2];

  dim_fecha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF4FB">
    <TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>dim_fecha</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK fecha_key</B></TD></TR>
    <TR><TD ALIGN="LEFT">fecha, anio, mes, dia</TD></TR>
    <TR><TD ALIGN="LEFT">nombre_dia, es_fin_de_semana</TD></TR>
    <TR><TD ALIGN="LEFT">es_festivo, es_dia_habil</TD></TR></TABLE>>];
  dim_tiempo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF4FB">
    <TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>dim_tiempo</B> (grano hora)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK tiempo_key</B> (yyyymmddhh)</TD></TR>
    <TR><TD ALIGN="LEFT">FK fecha_key</TD></TR>
    <TR><TD ALIGN="LEFT">hora, franja_horaria</TD></TR>
    <TR><TD ALIGN="LEFT">es_dia_habil, <B>es_hora_pico</B></TD></TR></TABLE>>];
  dim_usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF4FB">
    <TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>dim_usuario</B> (seudonimizada)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK usuario_sk</B> = md5(sal + persona)</TD></TR>
    <TR><TD ALIGN="LEFT">sistemas_con_tarjeta, es_multisistema</TD></TR>
    <TR><TD ALIGN="LEFT">en_padron, perfil, zona_residencia_key</TD></TR></TABLE>>];
  dim_sistema [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF4FB">
    <TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>dim_sistema</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK sistema_key</B></TD></TR>
    <TR><TD ALIGN="LEFT">sistema_codigo (TM, TU, MR, AM)</TD></TR>
    <TR><TD ALIGN="LEFT">tipo_transporte, unidad_registro</TD></TR></TABLE>>];
  dim_estacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF4FB">
    <TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>dim_estacion</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK estacion_key</B></TD></TR>
    <TR><TD ALIGN="LEFT">FK sistema_key, FK zona_key</TD></TR>
    <TR><TD ALIGN="LEFT">nombre_estacion, linea_ruta_eje, orden_metroriel</TD></TR></TABLE>>];
  dim_zona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF4FB">
    <TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>dim_zona</B> (conformada)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK zona_key</B></TD></TR>
    <TR><TD ALIGN="LEFT">nombre_zona, tipo_territorio</TD></TR>
    <TR><TD ALIGN="LEFT">tiene_transmetro … tiene_aerometro</TD></TR>
    <TR><TD ALIGN="LEFT">tiene_servicio, en_trazado_metroriel</TD></TR></TABLE>>];

  fct_abordaje [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4E5">
    <TR><TD BGCOLOR="#C55A11"><FONT COLOR="white"><B>fct_abordaje</B> (hecho principal)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><I>Grano: un abordaje de un usuario en una estación</I></TD></TR>
    <TR><TD ALIGN="LEFT"><I>de cualquiera de los cuatro sistemas</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK abordaje_key</B></TD></TR>
    <TR><TD ALIGN="LEFT">FK tiempo_key, fecha_key, usuario_sk</TD></TR>
    <TR><TD ALIGN="LEFT">FK sistema_key, estacion_key, zona_key</TD></TR>
    <TR><TD ALIGN="LEFT">abordaje_id_origen, tipo_validacion (degeneradas)</TD></TR>
    <TR><TD ALIGN="LEFT">cantidad_abordajes <FONT COLOR="#2E7D32">[aditiva]</FONT></TD></TR>
    <TR><TD ALIGN="LEFT">monto_q <FONT COLOR="#2E7D32">[aditiva]</FONT></TD></TR></TABLE>>];
  fct_trayecto [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4E5">
    <TR><TD BGCOLOR="#C55A11"><FONT COLOR="white"><B>fct_trayecto_metroriel</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><I>Grano: un viaje completo de MetroRiel</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK trayecto_key</B></TD></TR>
    <TR><TD ALIGN="LEFT">FK tiempo_key, fecha_key, usuario_sk</TD></TR>
    <TR><TD ALIGN="LEFT">FK estacion_origen_key, estacion_destino_key</TD></TR>
    <TR><TD ALIGN="LEFT">FK zona_origen_key, zona_destino_key</TD></TR>
    <TR><TD ALIGN="LEFT">cantidad_trayectos, duracion_min <FONT COLOR="#2E7D32">[aditivas]</FONT></TD></TR>
    <TR><TD ALIGN="LEFT">estaciones_recorridas, monto_q <FONT COLOR="#2E7D32">[aditivas]</FONT></TD></TR></TABLE>>];
  fct_padron [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4E5">
    <TR><TD BGCOLOR="#C55A11"><FONT COLOR="white"><B>fct_padron_diario</B> (snapshot)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><I>Grano: día × zona × perfil × operador</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> fecha_key, zona_key, perfil, operador_tarjeta</TD></TR>
    <TR><TD ALIGN="LEFT">tarjetas_activas <FONT COLOR="#B8860B">[semi-aditiva]</FONT></TD></TR>
    <TR><TD ALIGN="LEFT">altas_del_dia, bajas_del_dia <FONT COLOR="#2E7D32">[aditivas]</FONT></TD></TR></TABLE>>];

  dim_fecha -> dim_tiempo;
  dim_sistema -> dim_estacion; dim_zona -> dim_estacion;
  dim_tiempo -> fct_abordaje; dim_fecha -> fct_abordaje; dim_usuario -> fct_abordaje;
  dim_sistema -> fct_abordaje; dim_estacion -> fct_abordaje; dim_zona -> fct_abordaje;
  dim_tiempo -> fct_trayecto; dim_fecha -> fct_trayecto; dim_usuario -> fct_trayecto;
  dim_estacion -> fct_trayecto [label=" origen / destino", fontsize=9];
  dim_zona -> fct_trayecto [label=" origen / destino", fontsize=9];
  dim_fecha -> fct_padron; dim_zona -> fct_padron [label=" residencia", fontsize=9];
}
